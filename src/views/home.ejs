<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="stylesheet" type="text/css" href="css/site.css">
</head>
<body>
   <div class="maincontainer">
  <%- include('partials/header'); %>

  <% if (userType) { %>
    <div class="welcometext" id="welcometext">
      Dobrodošli, <%= userType %>!
    </div>
      <% if (userType === 'Organizator') { %>
        <%- include('partials/organizator'); %>
      <% } else if (userType === 'Voditelj kluba') { %>
        <%- include('partials/voditeljkluba'); %>
      <% } else if (userType === 'Sudac') { %>
        <%- include('partials/sudac'); %>
      <% } else if (userType === 'Administrator') { %>
        <%- include('partials/admin'); %>
      <% } %>
    <form action="/settings" method="POST">
      <input class="mainbutton" type="submit" value="Upravljanje računom">
    </form>
  <% } else { %>
    <%- include('partials/main'); %>
    <form action="/login" method="POST">
      <input class="mainbutton" type="submit" value="Prijava">
    </form>
  <% } %>
</div>

</body>
</html>